<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="#1B1C1E">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⌨️ AI Klavye"
        android:textColor="#E8EAED"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tv_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Kontrol ediliyor..."
        android:textColor="#9E9E9E"
        android:textSize="14sp"
        android:layout_marginBottom="40dp" />

    <Button
        android:id="@+id/btn_enable_keyboard"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="1. Klavyeyi Etkinleştir"
        android:textAllCaps="false"
        android:textColor="#1B1C1E"
        android:textSize="16sp"
        android:backgroundTint="#8AB4F8"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btn_select_keyboard"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="2. AI Klavyeyi Seç"
        android:textAllCaps="false"
        android:textColor="#E8EAED"
        android:textSize="16sp"
        android:backgroundTint="#3A3A3C" />

</LinearLayout>
